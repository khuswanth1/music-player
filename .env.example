# Backend configuration for running outside Docker. Copy to backend/.env.
# Every setting is documented in app/core/config.py.

ENVIRONMENT=development
LOG_JSON=false
LOG_LEVEL=INFO

# PostgreSQL. scripts/dev-db.ps1 starts a project-local cluster on port 5433 and prints these URLs.
DATABASE_URL=postgresql+psycopg://spotify:CHANGE_ME@127.0.0.1:5433/spotify
TEST_DATABASE_URL=postgresql+psycopg://spotify:CHANGE_ME@127.0.0.1:5433/spotify_test

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME

FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

BILLING_PROVIDER=dev
STRIPE_WEBHOOK_SECRET=whsec_dev_replace_me
STRIPE_SECRET_KEY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STORAGE_BACKEND=local
EMAIL_BACKEND=console

SEED_DEMO_PASSWORD=wavely-demo-2026

# --- open music catalogs (docs/MUSIC_SOURCES.md) -----------------------------
# Enabled sources, in priority order. "audius" is available but off by default (open uploads).
MUSIC_PROVIDERS=jamendo,internet_archive,wikimedia_commons,itunes,openverse,ccmixter,musicbrainz
# Identify your deployment to providers; MusicBrainz requires a contact URL or email.
MUSIC_USER_AGENT=Wavely/1.0 (+https://example.com/contact)
# Free key from https://devportal.jamendo.com (non-commercial use; commercial needs Jamendo Licensing)
JAMENDO_CLIENT_ID=
# true = commercial service: NonCommercial (CC BY-NC*) tracks are excluded from playback
COMMERCIAL_DEPLOYMENT=false
MUSIC_DOWNLOADS_ENABLED=true
# true = also list commercial songs as 30-second provider previews (iTunes), labelled Preview; full playback stays limited to licensed sources
MUSIC_PREVIEWS_VISIBLE=true
# Signs rights notices (takedowns) sent to /api/v1/catalog/webhooks. Required in production.
CATALOG_WEBHOOK_SECRET=whsec_catalog_replace_me
# Background sync of popular tracks per language (ISO codes)
CATALOG_SYNC_ENABLED=false
CATALOG_SYNC_LANGUAGES=te,hi,ta,kn,ml,bn,pa,en,ko,ja,zh,ar,es,fr,pt,de
# Per-provider daily request quotas (requests are refused locally once used up)
JAMENDO_DAILY_QUOTA=1000
INTERNET_ARCHIVE_DAILY_QUOTA=5000
OPENVERSE_DAILY_QUOTA=200
CCMIXTER_DAILY_QUOTA=2000
MUSICBRAINZ_DAILY_QUOTA=20000

# --- podcasts (docs/MUSIC_SOURCES.md) ---------------------------------------------------------
# Apple Podcasts search and publisher RSS feeds work with no key. These add more catalogs; leave blank to skip them.
# Podcast Index (free): https://api.podcastindex.org/signup
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=
# Listen Notes (optional, strict free-plan quota): https://www.listennotes.com/api/
LISTEN_NOTES_API_KEY=
PODCAST_INDEX_DAILY_QUOTA=5000
LISTEN_NOTES_DAILY_QUOTA=300
ITUNES_DAILY_QUOTA=20000
