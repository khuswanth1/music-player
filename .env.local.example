# Copy this to .env.local for local development
# (Never commit .env.local — it's already in .gitignore)

# Backend URL — Vite proxies /api/* here in dev mode
VITE_BACKEND_URL=http://localhost:8000

# Optional: links shown on the register page's terms step
# VITE_TERMS_URL=https://your-domain.com/terms
# VITE_PRIVACY_URL=https://your-domain.com/privacy

# Optional: enables "Connect Spotify" (full playback of preview-only tracks for Spotify Premium listeners).
# Client ID of a free app from https://developer.spotify.com/dashboard; add http://localhost:5173/spotify/callback as a redirect URI.
# VITE_SPOTIFY_CLIENT_ID=
